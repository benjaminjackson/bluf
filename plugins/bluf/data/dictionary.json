  "locks": [
    {
      "term": "on track",
      "rule": "1.3",
      "meaning": "The committed date and scope will hold. Nothing else."
    },
    {
      "term": "at risk",
      "rule": "1.3",
      "meaning": "A named trigger could break the date or scope; the risk statement exists (Rule 7.2)."
    },
    {
      "term": "off track",
      "rule": "1.3",
      "meaning": "The committed date or scope will not hold. A new date or scope is proposed in the same document."
    },
    {
      "term": "blocked",
      "rule": "1.3",
      "meaning": "Work cannot proceed without a named external action. Waiting on yourself is not blocked."
    },
    {
      "term": "decision",
      "rule": "1.3",
      "meaning": "A choice was made by a named person on a date. \"We need a decision\" names the decider."
    },
    {
      "term": "done",
      "rule": "1.3",
      "meaning": "Shipped, delivered, or signed — verifiable by a third party. Not \"done pending review.\""
    },
    {
      "term": "owner",
      "rule": "1.3",
      "meaning": "The one person answerable for the outcome. An owner is never a team, a committee, or \"us.\""
    },
    {
      "term": "deadline",
      "rule": "1.3",
      "meaning": "A date with a stated consequence for missing it. A date without a consequence is a target."
    },
    {
      "term": "target",
      "rule": "1.3",
      "meaning": "A date or number we aim at, with no external consequence if missed."
    },
    {
      "term": "estimate",
      "rule": "1.3",
      "meaning": "A number the writer derived and stands behind, with stated confidence."
    },
    {
      "term": "opinion",
      "rule": "1.3",
      "meaning": "A judgment the writer holds; no number claimed."
    },
    {
      "term": "critical path",
      "rule": "1.3",
      "meaning": "The sequence of dependent tasks that sets minimum completion time. Not \"important things.\""
    },
    {
      "term": "material",
      "rule": "1.3",
      "meaning": "Accounting sense only: large enough to change a decision.",
      "exceptions": ["material weakness"]
    },
    {
      "term": "priority",
      "rule": "1.3",
      "meaning": "An item that displaces other items. More than three concurrent priorities means none exist."
    }
  ],
