#!/bin/sh
# Regenerate the plugin copy of the standard from the canonical root copy.
# The plugin ships a real file, not a symlink: local-path installs skip
# symlinks that resolve outside the plugin directory.
set -e
cd "$(dirname "$0")/.."
mkdir -p bluf/docs
cp -f docs/SEE-100.md bluf/docs/SEE-100.md
echo "bluf/docs/SEE-100.md regenerated from docs/SEE-100.md"
